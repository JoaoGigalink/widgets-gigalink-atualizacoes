{
  "name": "widgets-gigalink",
  "version": "0.2.0",
  "description": "Widgets de desktop Gigalink (dados via HTTP local)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:publish": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "br.net.gigalink.widgets",
    "productName": "Widgets Gigalink",
    "files": [
      "main.js",
      "preload.js",
      "login.html",
      "trocar-senha.html",
      "config-vendedores.html",
      "config/**/*",
      "widgets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "publish": {
      "provider": "github",
      "owner": "JoaoGigalink",
      "repo": "widgets-gigalink-atualizacoes"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
